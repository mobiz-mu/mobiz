# MoBiz.mu — environment variables
#
# Copy this file to `.env.local` and fill in the values you need:
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored. Never commit real values.
#
# Both variables below are OPTIONAL and SERVER-SIDE ONLY. Neither is prefixed
# with NEXT_PUBLIC_, so neither is ever bundled into client JavaScript.
#
# The whole site builds and runs with this file empty. If OPENAI_API_KEY is
# absent the AI assistant disables itself cleanly: /api/ai-chat returns a
# `disabled` response, the launcher is not shown, and every page keeps working
# with WhatsApp as the contact route. Nothing else depends on these.


# OpenAI API key for the /api/ai-chat assistant.
# Optional. Leave blank to ship the site with the AI assistant switched off.
# Server-only — read in src/app/api/ai-chat/route.ts. Do NOT rename this to
# NEXT_PUBLIC_OPENAI_API_KEY; that would expose the key to every visitor.
OPENAI_API_KEY=

# Chat model used by the assistant.
# Optional. Defaults to "gpt-4o-mini" when unset (see src/lib/ai/config.ts).
# Only has any effect when OPENAI_API_KEY is also set.
OPENAI_MODEL=
